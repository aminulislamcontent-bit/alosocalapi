  nodesJson        String                 @default("[]")
  edgesJson        String                 @default("[]")
  retryPolicyJson  String                 @default("{}")
  requiresApproval Boolean                @default(true)
  createdBy        String                 @default("admin")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  runs             FactoryAutomationRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
}

model FactoryAutomationRun {
  id                  String                    @id @default(cuid())
  workspaceId         String
  workspace           FactoryWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowId          String
