  contactId   String?
  email       String
  messageId   String
  status      String
  adapterUsed String
  bounceType  String?
  detail      String?
  createdAt   DateTime      @default(now())

  @@index([workspaceId, campaignId, status])
  @@index([email])
}

model VoiceCompliancePolicy {
  id                         String           @id @default(cuid())
  workspaceId                String           @unique
  workspace                  FactoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timezone                   String           @default("Asia/Dhaka")
