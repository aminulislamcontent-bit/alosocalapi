generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Admin (Al-Amin) master account
model AdminUser {
  id                         String   @id @default(cuid())
  username                   String   @unique
  passwordHash               String
  mfaEnabled                 Boolean  @default(false)
  mfaSecretCiphertext        String?
  mfaPendingSecretCiphertext String?
  mfaPendingSecretExpiresAt  DateTime?
  // JSON array of SHA-256 hashes; recovery codes are shown only once at creation.
  recoveryCodeHashes         String   @default("[]")
  createdAt                  DateTime @default(now())
}

// Client onboarding accounts — created by admin with temp credentials
model ClientAccount {
  id           String            @id @default(cuid())
  name         String
  business     String
  phone        String?
  username     String            @unique
  passwordHash String
  // active | locked | completed
  status       String            @default("active")
  // §8 tenant-level data retention window in days (null = retention sweep disabled)
  retentionDays Int?
  // JSON array of platform keys e.g. ["facebook","whatsapp"]
  platforms    String            @default("[]")
  note         String?
  createdAt    DateTime          @default(now())
  completedAt  DateTime?
  entries      CredentialEntry[]
  logs         ActivityLog[]
  // Growth engine (tenant workspace)
  targetingProfiles    TargetingProfile[]
  acquisitionCampaigns AcquisitionCampaign[]
  acqLeads             AcqLead[]
  approvalRequests     ApprovalRequest[]
  governanceEntries    ContactGovernance[]
  websiteAudits        WebsiteAudit[]
  contentItems         ContentItem[]
}

// Server-side sessions (revocable)
model PortalSession {
  token     String   @id
  role      String // admin | client
  adminId   String?
  clientId  String?
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([adminId, expiresAt])
  @@index([clientId, expiresAt])
}

// DB-backed login throttle; key is a one-way username/role digest, never an IP or credential.
model LoginThrottle {
  key             String   @id
  failures        Int      @default(0)
  windowStartedAt DateTime @default(now())
  lockedUntil     DateTime?
  updatedAt       DateTime @updatedAt
}


// One collected credential value per (client, platform, field)
model CredentialEntry {
  id        String        @id @default(cuid())
  clientId  String
  client    ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform  String
  fieldKey  String
  value     String        @default("")
  // pending | collected | skipped
  status    String        @default("pending")
  // Offline format check only: none | format_only | invalid | error; never a provider authorization state.
  validationStatus  String   @default("none")
  validationNote    String   @default("")
  validatedAt       DateTime?
  updatedAt DateTime      @updatedAt

  @@unique([clientId, platform, fieldKey])
}

// Audit trail — who did what (fits "IP Access" theme)
model ActivityLog {
  id        String         @id @default(cuid())
  clientId  String?
  client    ClientAccount? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor     String // admin | client | system
  action    String
  detail    String?
  ip        String?
  createdAt DateTime       @default(now())
}

// ─────────────────────────────────────────────────────────────
// ALO Education BD — CRM & Automation
// ─────────────────────────────────────────────────────────────

// Students / guardians / business contacts
model Contact {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  email        String?
  // student | guardian | business | other
  kind         String        @default("student")
  grade        String? // interested class/course level
  // youtube | facebook | whatsapp | referral | walk_in | phone | manual
  source       String        @default("manual")
  address      String?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  leads        Lead[]
  interactions Interaction[]
  tasks        CrmTask[]

  @@index([name])
  @@index([phone])
}

// Enrollment opportunities moving through the admission pipeline
model Lead {
  id           String        @id @default(cuid())
  contactId    String
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title        String // e.g. "IELTS কোর্সে ভর্তি"
  // new | contacted | demo | negotiated | enrolled | lost
  stage        String        @default("new")
  value        Int           @default(0) // expected fee in BDT
  course       String?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  interactions Interaction[]
  tasks        CrmTask[]

  @@index([stage])
  @@index([contactId])
}

// Follow-up tasks (manual or automation-generated)
model CrmTask {
  id          String    @id @default(cuid())
  title       String
  done        Boolean   @default(false)
  dueAt       DateTime?
  // low | medium | high
  priority    String    @default("medium")
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // manual | rule:<automationRuleId>
  origin      String    @default("manual")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([done])
  @@index([dueAt])
}

// Timeline of communications (calls, WhatsApp, notes, system events)
model Interaction {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  // call | whatsapp | email | meeting | note | system
  channel   String   @default("note")
  body      String
  // manual | rule:<automationRuleId>
  origin    String   @default("manual")
  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([createdAt])
}

// If-This-Then-That rules evaluated server-side on CRM events
model AutomationRule {
  id        String          @id @default(cuid())
  name      String
  // lead_created | stage_changed | task_completed
  trigger   String
  // for stage_changed: the stage value to match, e.g. "enrolled"; null = any
  condition String?
  // create_task | log_interaction
  action    String
  // JSON: {title, dueInHours, priority, channel, body}
  payload   String          @default("{}")
  enabled   Boolean         @default(true)
  builtIn   Boolean         @default(false)
  createdAt DateTime        @default(now())
  runs      AutomationRun[]

  @@index([trigger])
}

// Execution record for every automation firing
model AutomationRun {
  id        String         @id @default(cuid())
  ruleId    String
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  leadId    String?
  contactId String?
  detail    String?
  // success | skipped
  status    String         @default("success")
  createdAt DateTime       @default(now())

  @@index([ruleId])
  @@index([createdAt])
}

// Knowledge base — courses, fees, schedules, policies, FAQs
model KnowledgeEntry {
  id        String   @id @default(cuid())
  title     String
  // course | fee | schedule | policy | faq
  category  String   @default("general")
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ─────────────────────────────────────────────────────────────
// UNIVERSAL LEAD DISCOVERY & GROWTH ENGINE (multi-tenant)
// ─────────────────────────────────────────────────────────────

// Dynamic industry taxonomy — admin-extensible, no code rewrites
model IndustryTaxonomy {
  id         String  @id @default(cuid())
  slug       String  @unique
  nameEn     String
  nameBn     String
  parentSlug String? // null = top-level category
  level      Int     @default(1) // 1 = category, 2 = sub-industry
  keywords   String  @default("[]") // JSON array of en/bn match keywords
  custom     Boolean @default(false)
  active     Boolean @default(true)
  createdAt  DateTime @default(now())

  @@index([parentSlug])
}

// Maintained country reference (ISO 3166-1 alpha-2)
model GeoCountry {
  code    String  @id // ISO alpha-2
  nameEn  String
  nameBn  String
  region  String // continent / UN region
  currency String?
  active  Boolean @default(true)
}

// Admin-added regions/cities/postal areas for granular targeting
model GeoArea {
  id          String   @id @default(cuid())
  countryCode String
  admin1      String? // state/division
  city        String?
  postal      String?
  lat         Float?
  lon         Float?
  custom      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([countryCode])
}

// Provider registry — never claimed free/integrated until verified
model ProviderRegistry {
  key               String    @id
  name              String
  // google | market | social | opendata | directory
  category          String
  sourceUrl         String
  accessMethod      String // rss | rest_api | sparql | oauth2_api | manual
  dataFields        String    @default("[]")
  authRequired      Boolean   @default(false)
  freeTier          String    @default("{}") // JSON limits
  paidTier          String    @default("{}")
  rateLimit         String    @default("{}")
  licensing         String
  geoCoverage       String    @default("global")
  lastVerifiedAt    DateTime?
  // planned | verified | rate_limited | blocked_here | requires_credentials | failing
  integrationStatus String    @default("planned")
  reliability       String    @default("unknown") // high | medium | low | unknown
  notes             String?
  lastCheck         String? // JSON of last verification result
  updatedAt         DateTime  @updatedAt
}

// Reusable targeting profile (client-scoped)
model TargetingProfile {
  id             String        @id @default(cuid())
  clientId       String
  client         ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String
  industries     String        @default("[]") // JSON slugs
  countries      String        @default("[]") // JSON ISO codes
  areas          String        @default("[]") // JSON GeoArea ids or free text
  audience       String? // target customer description
  keywords       String        @default("[]")
  intentSignals  String        @default("[]")
  competitorRefs String        @default("[]")
  exclusions     String        @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([clientId])
}

// Campaign — Mode B targeting + budget policy + source selection
model AcquisitionCampaign {
  id                    String        @id @default(cuid())
  clientId              String
  client                ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profileId             String?
  name                  String
  // universal | targeted
  mode                  String        @default("targeted")
  objective             String?
  // free_only | free_first | paid_with_approval
  budgetPreference      String        @default("free_first")
  // §12: suggest_only | approval_required | approved_automation
  autonomy              String        @default("approval_required")
  sourceKeys            String        @default("[]") // enabled provider keys
  qualificationCriteria String        @default("{}") // JSON thresholds
  exclusions            String        @default("[]")
  // draft | active | paused | completed
  status                String        @default("draft")
  stats                 String        @default("{}")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  runs                  DiscoveryRun[]

  @@index([clientId, status])
}

// One discovery execution with full provenance
model DiscoveryRun {
  id         String               @id @default(cuid())
  clientId   String
  campaignId String?
  campaign   AcquisitionCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  mode       String
  // queued | running | completed | partial | failed
  status     String               @default("queued")
  params     String               @default("{}")
  stats      String               @default("{}")
  logs       String               @default("[]")
  startedAt  DateTime             @default(now())
  finishedAt DateTime?

  @@index([clientId, startedAt])
}

// Discovered public business lead (tenant-isolated, provenance-required)
model AcqLead {
  id                   String        @id @default(cuid())
  clientId             String
  client               ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignId           String?
  runId                String?
  fingerprint          String // dedupe hash
  businessName         String
  website              String?
  category             String? // industry slug
  countryCode          String?
  regionName           String?
  cityName             String?
  publicContactChannel String? // public business contact channel only
  contactType          String? // website_form | public_email | public_phone | social_page
  productsServices     String?
  description          String?
  // provenance (mandatory)
  sourceProviderKey    String
  sourceUrl            String
  evidence             String        @default("[]") // JSON [{type, detail, url}]
  usageRestrictions    String?
  confidence           Float         @default(0.5)
  freshnessAt          DateTime?
  // unverified | verified | rejected | duplicate
  reviewStatus         String        @default("unverified")
  // discovered | data_validation | qualification_review | qualified | assigned |
  // contact_permitted | contacted | follow_up | opportunity | customer | closed |
  // rejected | duplicate | unverified | do_not_contact | opted_out | data_expired
  pipelineStatus       String        @default("discovered")
  score                Float?
  scoreBreakdown       String? // JSON component scores + explanations
  intentSignals        String        @default("[]")
  assignedTo           String?
  lawfulBasis          String? // public_business_info | consent | contract
  consentStatus        String        @default("not_collected") // not_collected | granted | refused
  followUpAt           DateTime?     // §8 scheduled follow-up
  firstSeenAt          DateTime      @default(now())
  lastSeenAt           DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  activities           AcqLeadActivity[]

  @@unique([clientId, fingerprint])
  @@index([clientId, pipelineStatus])
  @@index([clientId, reviewStatus])
}

model AcqLeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      AcqLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId  String
  // note | status_change | score | assignment | contact | import | governance
  type      String
  actor     String
  data      String   @default("{}")
  createdAt DateTime @default(now())

  @@index([leadId])
}

// Human-approval workflow (paid usage, publishing, exports, outbound contact…)
model ApprovalRequest {
  id            String         @id @default(cuid())
  clientId      String?
  client        ClientAccount? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // paid_usage | bulk_export | outbound_contact | public_publish | credential_change | integration_change
  type          String
  payload       String         @default("{}")
  // pending | approved | rejected | expired
  status        String         @default("pending")
  justification String?
  requestedBy   String?
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  @@index([clientId, status])
}

// Per-provider consumption tracking + cost ledger (USD)
model ProviderUsage {
  id          String   @id @default(cuid())
  clientId    String?
  providerKey String
  units       Int      @default(1)
  // requests | articles | entities | audits
  unitType    String   @default("requests")
  windowStart DateTime @default(now())

  @@index([providerKey, windowStart])
}

model CostLedger {
  id           String   @id @default(cuid())
  clientId     String?
  providerKey  String
  period       String // YYYY-MM
  units        Int      @default(0)
  estimatedUsd Float    @default(0)
  note         String?

  @@unique([clientId, providerKey, period])
}

// Contact governance: DNC / opt-out / consent registry
model ContactGovernance {
  id         String        @id @default(cuid())
  clientId   String
  client     ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // website_form | public_email | public_phone | social_page | whatsapp | sms | email
  channel    String
  identifier String // normalized phone/email/domain
  // allow | dnc | opted_out
  status     String        @default("dnc")
  reason     String?
  source     String? // who registered it
  createdAt  DateTime      @default(now())

  @@unique([clientId, channel, identifier])
  @@index([clientId, status])
}

// Immutable audit events for engine actions
model AuditEvent {
  id            String   @id @default(cuid())
  clientId      String?
  actor         String
  actorRole     String
  action        String
  resource      String
  resourceId    String?
  before        String? // JSON
  after         String? // JSON
  justification String?
  ip            String?
  createdAt     DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([action])
}

// Universal discovery output — market opportunity reports
model OpportunityReport {
  id          String   @id @default(cuid())
  clientId    String?
  runId       String?
  scope       String   @default("{}") // JSON countries, industries
  findings    String   @default("[]") // JSON ranked opportunities with evidence
  sources     String   @default("[]") // JSON provider keys used
  generatedAt DateTime @default(now())
}

// Website growth audits (PageSpeed Insights real data)
model WebsiteAudit {
  id              String        @id @default(cuid())
  clientId        String
  client          ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url             String
  psiData         String        @default("{}") // raw PSI lab data
  scores          String        @default("{}") // performance/seo/accessibility/bp
  recommendations String        @default("[]") // JSON actionable items
  // completed | rate_limited | failed
  status          String        @default("completed")
  createdAt       DateTime      @default(now())

  @@index([clientId, createdAt])
}

// Social content calendar (draft → approval → publish; no fake engagement)
model ContentItem {
  id           String        @id @default(cuid())
  clientId     String
  client       ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform     String // facebook | instagram | youtube | linkedin | tiktok | x
  scheduledFor DateTime?
  draft        String
  hashtags     String        @default("[]")
  // idea | draft | awaiting_approval | approved | published | rejected
  status       String        @default("idea")
  approvedBy   String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([clientId, status])
}


// ─────────────────────────────────────────────────────────────
// ALOAPI Integration Intelligence (isolated from CRM/marketing data)
// ─────────────────────────────────────────────────────────────

model IntegrationProvider {
  key                String   @id
  category           String
  metadata           String   @default("{}") // non-secret structured provider catalogue JSON
  verificationStatus String   @default("DISCOVERED")
  lastCheckedAt      DateTime?
  lastCheck          String   @default("{}") // evidence only; secrets must never be stored here
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  accounts           IntegrationAccount[]
  credentials        IntegrationSecret[]
  webhookEvents      IntegrationWebhookEvent[]

  @@index([category, verificationStatus])
}

model IntegrationAccount {
  id                    String   @id @default(cuid())
  providerKey            String
  provider               IntegrationProvider @relation(fields: [providerKey], references: [key], onDelete: Cascade)
  businessName           String?
  accountIdentifier      String? // non-secret provider ID, recorded only when explicitly supplied
  phoneNumberCiphertext  String? // phone is PII; encrypted with the vault key
  verificationStatus     String   @default("REQUIRES_USER_ACTION")
  manualRequirements     String   @default("[]")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  credentials            IntegrationSecret[]

  @@index([providerKey, verificationStatus])
}

model IntegrationSecret {
  id          String   @id @default(cuid())
  providerKey String
  provider    IntegrationProvider @relation(fields: [providerKey], references: [key], onDelete: Cascade)
  accountId   String
  account     IntegrationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  ciphertext  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([providerKey, accountId, name])
  @@index([providerKey, accountId])
}

// Security-relevant integration actions, without secret values or raw webhook bodies.
model IntegrationAuditEvent {
  id          String   @id @default(cuid())
  actor       String
  action      String
  providerKey String?
  accountId   String?
  detail      String   @default("")
  createdAt   DateTime @default(now())

  @@index([providerKey, createdAt])
  @@index([action, createdAt])
}

// WhatsApp webhook receipt log stores only event names/counts, never payload contents.
model IntegrationWebhookEvent {
  id          String   @id @default(cuid())
  providerKey String
  provider    IntegrationProvider @relation(fields: [providerKey], references: [key], onDelete: Cascade)
  eventType   String
  createdAt   DateTime @default(now())

  @@index([providerKey, createdAt])
  @@index([eventType, createdAt])
}

// ALOAPI-only retention settings. Payload storage is permanently disabled.
model IntegrationPrivacyPolicy {
  id                    String   @id @default("default")
  retentionDays         Int?     @default(365)
  storeWebhookPayloads  Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

// Ephemeral RSA key pairs used for browser credential transfer. Private-key
// ciphertext is encrypted using ALOAPI_VAULT_KEY; rows expire and are deleted
// atomically on first use, shared across all application workers.
model CredentialTransferKey {
  id                   String   @id
  privateKeyCiphertext String
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// ALOAPI Autonomous Marketing Onboarding & Multi-Agent Intelligence
// ─────────────────────────────────────────────────────────────

// 20-state standardized account registration & developer setup state machine
model OnboardingWorkflow {
  id                    String    @id @default(cuid())
  clientId              String
  providerKey           String
  state                 String    @default("NOT_STARTED")
  implementationLevel   Int       @default(1)
  ownerEmail            String?
  businessName          String?
  accountExistsDetected Boolean   @default(false)
  registrationMethod    String    @default("GUIDED_MANUAL")
  preparedPayload       String    @default("{}")
  developerAppConfig    String    @default("{}")
  pendingCheckpoint     String?
  ownerApprovedAt       DateTime?
  ownerApprovedBy       String?
  lastError             String?
  history               String    @default("[]")
  correlationId         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([clientId, providerKey])
  @@index([providerKey, state])
  @@index([state])
}

// Client requirements intake & platform recommendation plan
model ClientRequirementProfile {
  id                     String    @id @default(cuid())
  clientId               String?
  businessName           String
  businessType           String
  businessLocation       String
  targetMarket           String
  targetAudience         String
  marketingBudget        String
  monthlyContactVolume   Int       @default(0)
  advertisingBudget      String
  socialMediaChannels    String    @default("[]")
  emailRequirements      String    @default("{}")
  messagingRequirements  String    @default("{}")
  crmRequirements        String    @default("{}")
  ecommerceRequirements  String    @default("{}")
  automationComplexity   String    @default("medium")
  reportingRequirements  String    @default("{}")
  recommendations        String    @default("{}")
  selectedProviders      String    @default("[]")
  approvedProviders      String    @default("[]")
  approvedBy             String?
  approvedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([clientId])
}

// Tenant-isolated encrypted credential vault supporting all 8 credential types
model VaultCredential {
  id             String    @id @default(cuid())
  clientId       String
  providerKey    String
  credentialType String
  label          String    @default("default")
  ciphertext     String
  keyVersion     Int       @default(1)
  scopes         String    @default("[]")
  expiresAt      DateTime?
  refreshable    Boolean   @default(false)
  revokedAt      DateTime?
  revokedReason  String?
  status         String    @default("active")
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([clientId, providerKey, credentialType, label])
  @@index([clientId, providerKey])
  @@index([status, expiresAt])
}

// Single-use OAuth 2.0 state & PKCE verifier store
model OAuthAuthorizationState {
  id                     String    @id @default(cuid())
  state                  String    @unique
  clientId               String
  providerKey            String
  redirectUri            String
  scopes                 String    @default("[]")
  codeVerifierCiphertext String?
  status                 String    @default("pending")
  errorDetail            String?
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime  @default(now())

  @@index([clientId, providerKey])
  @@index([expiresAt])
}

// Isolated browser orchestration session state (no cookies or passwords stored)
model BrowserWorkflowSession {
  id              String   @id @default(cuid())
  clientId        String
  providerKey     String
  workflowId      String?
  purpose         String
  officialUrl     String
  contextKey      String
  status          String   @default("idle")
  currentAction   String
  nextOwnerAction String?
  executionMode   String   @default("guided_browser_handoff")
  auditNotes      String   @default("[]")
  startedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId, providerKey])
  @@index([status])
}

// Multi-agent team execution log (Agents A-H)
model AgentExecutionRun {
  id                 String   @id @default(cuid())
  agentId            String
  agentName          String
  clientId           String?
  providerKey        String?
  action             String
  status             String   @default("completed")
  correlationId      String
  inputSummary       String   @default("{}")
  outputSummary      String   @default("{}")
  complianceDecision String   @default("ALLOWED")
  complianceReason   String?
  durationMs         Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([clientId, providerKey])
  @@index([correlationId])
}

// Omni-routing event bus with idempotency, retries, and dead-letter queue
model OmniEvent {
  id             String    @id @default(cuid())
  eventType      String
  eventName      String
  source         String
  idempotencyKey String    @unique
  correlationId  String
  clientId       String?
  providerKey    String?
  payload        String    @default("{}")
  status         String    @default("queued")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  nextAttemptAt  DateTime?
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([eventType, status])
  @@index([correlationId])
  @@index([status, nextAttemptAt])
}

// Post-login idempotent initialization report history
model SystemInitializationRun {
  id          String   @id @default(cuid())
  triggeredBy String
  status      String
  steps       String   @default("[]")
  summary     String   @default("{}")
  idempotent  Boolean  @default(true)
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Self-healing & integrity check/repair records
model SystemIntegrityRecord {
  id                  String   @id @default(cuid())
  checkType           String
  target              String
  status              String
  severity            String   @default("info")
  detail              String
  repaired            Boolean  @default(false)
  backupPath          String?
  verifiedAfterRepair Boolean  @default(false)
  requiresApproval    Boolean  @default(false)
  checkedAt           DateTime @default(now())

  @@index([checkType, status])
  @@index([checkedAt])
}

// Live/cached API documentation discovery & change detection snapshots
model ApiDiscoverySnapshot {
  id             String   @id @default(cuid())
  providerKey    String
  sourceUrl      String
  apiVersion     String
  docHash        String?
  previousHash   String?
  changed        Boolean  @default(false)
  fetchStatus    String
  discoveredMeta String   @default("{}")
  checkedAt      DateTime @default(now())

  @@index([providerKey, checkedAt])
}

