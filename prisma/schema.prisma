  workspaceId    String
  workspace      FactoryWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   FactoryCrmOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  fullName       String
  email          String?
  phone          String?
  jobTitle       String?
  source         String                  @default("direct")
  consentStatus  String                  @default("not_collected")
  assignedTo     String?
  tags           String                  @default("[]")
  nextFollowUpAt DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
