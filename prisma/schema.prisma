model FactoryWorkspace {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  planTier        String   @default("growth")
  status          String   @default("active")
  ownerUsername   String
  timezone        String   @default("Asia/Dhaka")
  defaultLanguage String   @default("en")
  settings        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members             FactoryWorkspaceMember[]
  providerConnections FactoryProviderConnection[]
  jobs                FactoryJob[]
  usageEvents         FactoryUsageEvent[]
  moduleConfigs       FactoryModuleConfig[]
  moduleRecords       FactoryModuleRecord[]
  emailDomains        EmailSendingDomain[]
  emailContacts       EmailContact[]
  emailTemplates      EmailTemplate[]
  emailCampaigns      EmailCampaign[]
  voicePolicy         VoiceCompliancePolicy?
  voiceConsents       VoiceConsentRecord[]
  voiceAgents         VoiceAgentProfile[]
  voiceCalls          VoiceCallSession[]
  workflows           FactoryAutomationWorkflow[]
  workflowRuns        FactoryAutomationRun[]
  crmOrgs             FactoryCrmOrganization[]
  crmContacts         FactoryCrmContact[]
  crmOpportunities    FactoryCrmOpportunity[]
  crmActivities       FactoryCrmActivity[]

  @@index([ownerUsername])
}

model FactoryWorkspaceMember {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   FactoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  username    String
  role        String           @default("operator")
  permissions String           @default("[]")
  status      String           @default("active")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([workspaceId, username])
  @@index([username, status])
}

model FactoryProviderConnection {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      FactoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  moduleKey      String
  providerKey    String
  status         String           @default("pending_authorization")
  scopes         String           @default("[]")
  configMeta     String           @default("{}")
  approvedBy     String?
  approvedAt     DateTime?
  lastVerifiedAt DateTime?
  lastError      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([workspaceId, moduleKey, providerKey])
  @@index([workspaceId, status])
}

model FactoryJob {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      FactoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  moduleKey      String
  jobType        String
  idempotencyKey String           @unique
  payload        String           @default("{}")
  status         String           @default("queued")
  attempts       Int              @default(0)
  maxAttempts    Int              @default(3)
  scheduledFor   DateTime         @default(now())
  nextRetryAt    DateTime?
  lastError      String?
  result         String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([workspaceId, moduleKey, status])
  @@index([status, scheduledFor])
}

model FactoryUsageEvent {
  id           String           @id @default(cuid())
  workspaceId  String
  workspace    FactoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  moduleKey    String
  metric       String
  quantity     Float            @default(1)
  unitCostUsd  Float            @default(0)
  totalCostUsd Float            @default(0)
  adapter      String           @default("local")
  metadata     String           @default("{}")
  createdAt    DateTime         @default(now())

  @@index([workspaceId, moduleKey, createdAt])
}

model FactoryModuleConfig {
  id                String           @id @default(cuid())
  workspaceId       String
  workspace         FactoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  moduleKey         String
  enabled           Boolean          @default(true)
  adapterMode       String           @default("local")
  config            String           @default("{}")
  operationalStatus String           @default("READY")
  updatedBy         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([workspaceId, moduleKey])
  @@index([moduleKey, operationalStatus])
}

model FactoryModuleRecord {
  id           String           @id @default(cuid())
  workspaceId  String
  workspace    FactoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  moduleKey    String
  recordType   String
  title        String
  status       String           @default("draft")
  data         String           @default("{}")
  tags         String           @default("[]")
  scheduledFor DateTime?
  createdBy    String           @default("admin")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([workspaceId, moduleKey, status])
  @@index([moduleKey, recordType])
}

model EmailSendingDomain {
  id                    String           @id @default(cuid())
  workspaceId           String
  workspace             FactoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain                String
  dkimSelector          String           @default("aloapi1")
  spfStatus             String           @default("unverified")
  dkimStatus            String           @default("unverified")
  dmarcStatus           String           @default("unverified")
  spfRecord             String           @default("v=spf1 ~all")
  dkimPublicKeyHint     String?
  dmarcPolicy           String           @default("v=DMARC1; p=quarantine;")
  reputationScore       Float            @default(100)
  sentCount             Int              @default(0)
  bounceCount           Int              @default(0)
  complaintCount        Int              @default(0)
  verifiedForProduction Boolean          @default(false)
  lastCheckedAt         DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  campaigns             EmailCampaign[]

  @@unique([workspaceId, domain])
  @@index([workspaceId, verifiedForProduction])
}

model EmailContact {
  id                String           @id @default(cuid())
  workspaceId       String
  workspace         FactoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email             String
  fullName          String?
  segment           String           @default("general")
  tags              String           @default("[]")
  consentStatus     String           @default("pending")
  consentSource     String           @default("manual")
  consentAt         DateTime?
  suppressedAt      DateTime?
  suppressionReason String?
  unsubscribeToken  String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([workspaceId, email])
  @@index([workspaceId, consentStatus, segment])
}

model EmailTemplate {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   FactoryWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  preheader   String?
  htmlBody    String
  textBody    String
  language    String           @default("en")
  variables   String           @default("[]")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  campaigns   EmailCampaign[]

  @@unique([workspaceId, name])
}

model EmailCampaign {
  id             String               @id @default(cuid())
  workspaceId    String
  workspace      FactoryWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  domainId       String?
  domain         EmailSendingDomain?  @relation(fields: [domainId], references: [id], onDelete: SetNull)
  templateId     String?
  template       EmailTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  segment        String               @default("general")
  status         String               @default("draft")
  adapterType    String               @default("smtp_custom")
  providerKey    String?
  approvalStatus String               @default("pending")
