# Local ALOAPI database. Back up before any reviewed schema synchronization.
DATABASE_URL="file:./db/custom.db"

# ── ALOAPI local service ─────────────────────────────────────────────
# The installed CLI binds only to 127.0.0.1; this value changes the port only.
ALOAPI_PORT="47831"
ALOAPI_HOST="127.0.0.1"
ALOAPI_BASE_URL="http://127.0.0.1:47831"
# REQUIRED for production. Generate a random 32+ byte key and protect it outside Git.
# Never change it after saving encrypted values unless you have migrated/re-encrypted them.
ALOAPI_VAULT_KEY=""
# Production bootstrap is one-time, created only when there are no administrators.
# Use a unique password with at least 16 characters; unset/rotate after bootstrap.
ADMIN_BOOTSTRAP_USERNAME=""
ADMIN_BOOTSTRAP_PASSWORD=""
# Keep false for first login; enroll admin MFA, then set true (otherwise setup is blocked).
ALOAPI_REQUIRE_ADMIN_MFA="false"
# Only set true behind a trusted reverse proxy which overwrites X-Real-IP.
ALOAPI_TRUST_PROXY="false"
# Optional HTTPS URL for provider callbacks. Admin UI remains loopback/private.
ALOAPI_PUBLIC_WEBHOOK_BASE_URL=""

# ── WhatsApp Business Platform / Meta ────────────────────────────────
# Values must come from the official Meta developer/business interfaces.
# Keep secrets in the encrypted ALOAPI vault; these names are templates only.
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ── Other provider secrets / IDs (only set for an authorized integration) ──
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_ACCESS_TOKEN=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_ACCESS_TOKEN=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_ACCESS_TOKEN=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
MICROSOFT_ADS_CLIENT_ID=""
MICROSOFT_ADS_CLIENT_SECRET=""
MICROSOFT_ADS_DEVELOPER_TOKEN=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_ACCESS_TOKEN=""
TELEGRAM_BOT_TOKEN=""
DISCORD_APPLICATION_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""

# ── AI Automation Server Provider Stack (optional; separate processes) ──
AUTOMATION_ORCHESTRATOR_URL=""
YBT_ARMY_URL=""
OBS_WEBSOCKET_URL=""
OBS_WEBSOCKET_PASSWORD=""
