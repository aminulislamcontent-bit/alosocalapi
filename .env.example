# SQLite database (Prisma). The db/ directory is created at runtime.
DATABASE_URL="file:./db/custom.db"

# ── AI Automation Server Provider Stack (providers/, see providers/README.md) ──
# Optional — only needed when the corresponding provider service is running.
AUTOMATION_ORCHESTRATOR_URL=""   # agency-orchestrator, e.g. http://localhost:8080
YBT_ARMY_URL=""                  # YBT-Army-135M local model, e.g. http://localhost:7860
OBS_WEBSOCKET_URL=""             # OBS Studio websocket, e.g. ws://localhost:4455
OBS_WEBSOCKET_PASSWORD=""
